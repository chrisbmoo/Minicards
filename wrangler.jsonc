// Cloudflare Worker config for minicards.com.au
// Deploys automatically from GitHub (Workers Builds runs `npx wrangler deploy`).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "minicards",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",

  // Generates the Cards page, card pages and sitemap from cards.json into dist/ before deploying
  "build": { "command": "node build.js" },

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // the card manager API is handled by the Worker; everything else is a static file
    "run_worker_first": ["/admin/api/*"]
  },

  // Keep the variables set in the dashboard (GITHUB_REPO, ACCESS_AUD, ...) when deploying
  "keep_vars": true,

  "workers_dev": true,
  "observability": { "enabled": true }
}
